{
  "name": "pickleball3-mcp",
  "version": "1.1.0",
  "type": "module",
  "description": "Read-only MCP server for the Pickleball3 paddle catalog: search, compare and inspect reviewed paddles with scores, measured specs and verified purchase links.",
  "scripts": {
    "start": "node ./index.mjs",
    "start:http": "node ./index-http.mjs",
    "test": "node ./test/conformance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gospodindark-stack/pickleball3-mcp.git"
  },
  "homepage": "https://pickleball3.com/api/",
  "bugs": {
    "url": "https://github.com/gospodindark-stack/pickleball3-mcp/issues"
  },
  "license": "MIT"
}
